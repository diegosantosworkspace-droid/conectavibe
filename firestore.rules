rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Lista de celulares autorizados na Portaria (ID = dígitos do celular, ex: 5511999999999)
    match /whitelist/{phoneId} {
      // Leitura permitida na portaria para validar se o celular foi convidado
      allow read: if true;
      // Escrita apenas para usuários autenticados (o bootstrap do primeiro Admin
      // agora faz signInAnonymously antes de gravar — ver app.js).
      // Leitura pública mantida para validar o celular na Portaria antes do login.
      allow create, update, delete: if isSignedIn();
    }

    // Perfis conectados
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSignedIn();
    }

    // Publicações do Mural
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 2
                    && request.resource.data.content is string
                    && request.resource.data.content.size() >= 2;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}